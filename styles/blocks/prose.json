{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Prose",
	"slug": "prose",
	"blockTypes": [ "core/group" ],
	"styles": {
		"typography": { "lineHeight": "1.75" },
		"elements": { "h2": { "typography": { "fontSize": "var:preset|font-size|2-xl" } }, "h3": { "typography": { "fontSize": "var:preset|font-size|xl" } }, "link": { "typography": { "textDecoration": "underline" } } },
		"css": "&>*+*{margin-block-start:var(--wp--preset--spacing--30)}&>h2{margin-block-start:var(--wp--preset--spacing--60)}&>h3{margin-block-start:var(--wp--preset--spacing--60)}&>:first-child{margin-block-start:0}&>:is(ul,ol){padding-inline-start:var(--wp--preset--spacing--40);line-height:1.7}& li+li{margin-block-start:.35rem}"
	}
}
