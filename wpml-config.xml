<wpml-config>
	<!--
		Declares which custom-block attributes Polylang (and its DeepL machine
		translation) should handle:

		  <key name="…"/>                 translatable text
		  <key name="…" type="link"/>     a URL — never sent to DeepL, but remapped
		                                  to the translated post's permalink for
		                                  internal links (matches the parent theme's
		                                  pediment/* convention)

		Attributes NOT listed — image URLs/IDs, booking query params, icons,
		variants — are copied verbatim to the translation untouched.

		Repeated content (tiles, cards, reviews, modes, chips, photos) is authored
		as child blocks, so each child block is declared on its own below.

		Placed at the theme root; Polylang loads it automatically.
	-->
	<gutenberg-blocks>
		<gutenberg-block type="workation/activity-list" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="workation/page-hero" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="workation/photo-gallery" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="workation/promo-banner" translate="1">
			<key name="headline"/>
			<key name="body"/>
			<key name="linkText"/>
			<key name="linkUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-activities" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="primaryText"/>
			<key name="primaryUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-audience" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-card" translate="1">
			<key name="eyebrow"/>
			<key name="title"/>
			<key name="text"/>
			<key name="linkText"/>
			<key name="linkUrl" type="link"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-chip" translate="1">
			<key name="title"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-closing" translate="1">
			<key name="headline"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
			<key name="primaryUrl" type="link"/>
			<key name="secondaryText"/>
			<key name="secondaryUrl" type="link"/>
			<key name="linkText"/>
			<key name="linkUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-gallery" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="primaryText"/>
			<key name="primaryUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-hero" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
			<key name="bookingUrl" type="link"/>
			<key name="secondaryText"/>
			<key name="secondaryUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-intro" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-location" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
			<key name="primaryUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-mode" translate="1">
			<key name="title"/>
			<key name="text"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-photo" translate="1">
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-review" translate="1">
			<key name="text"/>
			<key name="title"/>
			<key name="role"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-reviews" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="ctaText"/>
			<key name="ctaUrl" type="link"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-space" translate="1">
			<key name="eyebrow"/>
			<key name="title"/>
			<key name="text"/>
			<key name="linkText"/>
			<key name="linkUrl" type="link"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-spaces" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
		</gutenberg-block>
		<gutenberg-block type="workation/workation-tile" translate="1">
			<key name="title"/>
			<key name="imageAlt"/>
		</gutenberg-block>
	</gutenberg-blocks>
</wpml-config>
