<wpml-config>
	<!--
		Declares which custom-block attributes hold translatable text so Polylang
		(and its DeepL machine translation) picks them up. Attributes NOT listed
		here — URLs, booking params, icons, image IDs, variants — are intentionally
		left untranslated so DeepL can't mangle links or config.

		Repeated content (tiles, cards, reviews, modes, chips, photos) is authored
		as child blocks, so each child block is declared on its own below.

		Placed at the theme root; Polylang loads it automatically.
	-->
	<gutenberg-blocks>
		<gutenberg-block type="pediment-child/activity-list" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/page-hero" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/photo-gallery" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/promo-banner" translate="1">
			<key name="headline"/>
			<key name="body"/>
			<key name="linkText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-activities" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="primaryText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-audience" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-card" translate="1">
			<key name="eyebrow"/>
			<key name="title"/>
			<key name="text"/>
			<key name="linkText"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-chip" translate="1">
			<key name="title"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-closing" translate="1">
			<key name="headline"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
			<key name="secondaryText"/>
			<key name="linkText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-gallery" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="primaryText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-hero" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
			<key name="secondaryText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-intro" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-location" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
			<key name="imageAlt"/>
			<key name="primaryText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-mode" translate="1">
			<key name="title"/>
			<key name="text"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-photo" translate="1">
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-review" translate="1">
			<key name="text"/>
			<key name="title"/>
			<key name="role"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-reviews" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="ctaText"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-space" translate="1">
			<key name="eyebrow"/>
			<key name="title"/>
			<key name="text"/>
			<key name="linkText"/>
			<key name="imageAlt"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-spaces" translate="1">
			<key name="eyebrow"/>
			<key name="headline"/>
			<key name="lead"/>
		</gutenberg-block>
		<gutenberg-block type="pediment-child/workation-tile" translate="1">
			<key name="title"/>
			<key name="imageAlt"/>
		</gutenberg-block>
	</gutenberg-blocks>
</wpml-config>
