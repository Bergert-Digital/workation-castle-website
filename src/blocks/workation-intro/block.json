{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "pediment-child/workation-intro",
  "title": "Workation Intro",
  "category": "design",
  "description": "Workation Castle homepage intro section.",
  "textdomain": "pediment-child",
