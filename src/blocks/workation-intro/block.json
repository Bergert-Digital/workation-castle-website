    "headline": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "primaryText": {
      "type": "string",
      "default": ""
    },
    "primaryUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryText": {
      "type": "string",
      "default": ""
    },
    "secondaryUrl": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    }
