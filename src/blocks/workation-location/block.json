{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "pediment-child/workation-location",
  "title": "Workation Location",
  "category": "design",
  "description": "Location and getting-here section.",
  "textdomain": "pediment-child",
