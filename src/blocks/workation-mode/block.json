{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "workation/workation-mode",
  "title": "Workation Travel Mode",
  "category": "design",
  "description": "A single way to get here: icon, label, detail.",
  "parent": [ "workation/workation-location" ],
  "textdomain": "workation",
  "supports": { "html": false },
  "attributes": {
    "title": { "type": "string", "default": "" },
    "text": { "type": "string", "default": "" },
    "icon": { "type": "string", "default": "car" }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
