{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "workation/activity-map",
  "title": "Activity Map",
  "category": "design",
  "description": "Locator map: the castle, a destination and optional extra pins (activity pages, guide pages).",
  "textdomain": "workation",
  "supports": { "html": false },
  "attributes": {
    "lat":   { "type": "string", "default": "" },
    "lng":   { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "maxZoom": { "type": "number", "default": 13 }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
