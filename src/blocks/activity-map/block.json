{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "workation/activity-map",
  "title": "Activity Map",
  "category": "design",
  "description": "Locator map on an activity page: the castle and the activity's destination.",
  "textdomain": "workation",
  "supports": { "html": false },
  "attributes": {
    "lat":   { "type": "string", "default": "" },
    "lng":   { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
