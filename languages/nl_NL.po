#. Theme Name of the theme
#: style.css
msgid "Workation Castle"
msgstr "Workation Castle"

#. Theme URI of the theme
#: style.css
msgid "https://github.com/Bergert-Digital/workation-castle-website"
msgstr "https://github.com/Bergert-Digital/workation-castle-website"

#. Description of the theme
#: style.css
msgid "Custom WordPress theme for Workation Castle — an Italian castle between Lake Como and Lake Lugano where teams work, gather and unwind."
msgstr "Aangepast WordPress-thema voor Workation Castle — een Italiaans kasteel tussen het Comomeer en het Luganomeer waar teams werken, samenkomen en ontspannen."

#. Author of the theme
#: style.css
msgid "Jonas Bergert"
msgstr "Jonas Bergert"

#. Author URI of the theme
#: style.css
msgid "https://bergert.digital"
msgstr "https://bergert.digital"

